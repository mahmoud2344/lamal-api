# lamal-api configuration.
# Copy to .env and edit, or set these as environment variables.
# Every value below is the built-in default.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite needs no setup and is the right choice for a single VPS.
DATABASE_URL=sqlite:///./data/lamal.db
# PostgreSQL (install the extra: pip install "lamal-api[postgres]")
# DATABASE_URL=postgresql+psycopg://lamal:secret@localhost:5432/lamal

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Set when served behind a reverse proxy on a sub-path, e.g. /lamal
ROOT_PATH=

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*

# Simple per-IP cap. 0 disables it. Anything serious belongs in your proxy.
RATE_LIMIT_PER_MINUTE=0

# Largest page size a client may request.
MAX_PAGE_SIZE=500

# ---------------------------------------------------------------------------
# Data synchronisation
# ---------------------------------------------------------------------------
# Five-field cron expression, evaluated in UTC, for the in-process scheduler.
# Empty disables it — use your own cron and run `lamal-api sync` instead.
# New premium years appear in late September and are picked up automatically.
SYNC_CRON=

# Sync once when the server boots. Runs on a worker thread, so the API is
# available immediately and reports data_loaded=false until it finishes.
SYNC_ON_STARTUP=false

# Premium years to keep loaded: "2026", "2024,2026" or a range "2024-2026".
# Empty means "whatever year is currently published". Years other than the
# live one are read from the official yearly archives, which adds roughly
# 30 MB of download per year.
SYNC_YEARS=

# Seconds before a download from the federal servers is abandoned.
HTTP_TIMEOUT_SECONDS=180

# Sent to opendata.swiss and priminfo.admin.ch so they can identify the client.
# Please put your own contact URL here if you run this publicly.
USER_AGENT=lamal-api/0.1 (+https://github.com/mahmoud2344/lamal-api)

# Only needed behind a TLS-inspecting corporate proxy, whose root CA is not in
# the bundled certifi store. Path to a PEM file of trusted CA certificates.
CA_BUNDLE=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
